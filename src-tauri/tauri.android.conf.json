{
  "identifier": "jan.ai.app",
  "build": {
    "devUrl": null,
    "frontendDist": "../web-app/dist",
    "beforeDevCommand": "yarn prepare:android && cross-env IS_DEV=true IS_ANDROID=true yarn build:web",
    "beforeBuildCommand": "yarn prepare:android && cross-env IS_ANDROID=true yarn build:web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Atomic Chat"
      }
    ],
    "security": {
      "capabilities": ["mobile"]
    }
  },
  "plugins": {},
  "bundle": {
    "active": true,
    "resources": [
      "resources/pre-install/**/*",
      "resources/LICENSE",
      "resources/agent-skills/**/*"
    ],
    "externalBin": [],
    "android": {
      "minSdkVersion": 24
    }
  }
}
